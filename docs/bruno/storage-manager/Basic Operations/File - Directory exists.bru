meta {
  name: File / Directory exists
  type: http
  seq: 1
}

get {
  url: {{LaravelAppUrl}}/{{StorageManagerPrefix}}/fm/exists?path=New Text file.txt&disk=public
  body: none
  auth: inherit
}

params:query {
  path: New Text file.txt
  disk: public
}

settings {
  encodeUrl: true
  timeout: 0
}
