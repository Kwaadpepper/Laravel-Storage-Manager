includes:
    - vendor/pestphp/pest/extension.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    paths:
        - src

    level: 10

    excludePaths:
        - src/config


    # Enforce strict types analysis
    treatPhpDocTypesAsCertain: false
